# ──────────────────────────────────────────────────────────────────────────────
# Maplebrook International Academy — environment configuration
# Copy this file to `.env` and adjust the values for your environment.
# NEVER commit real secrets. The `.env` file is git-ignored.
# ──────────────────────────────────────────────────────────────────────────────

# --- Core ---------------------------------------------------------------
# Base URL of the deployed site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Security -----------------------------------------------------------
# Secret used to sign session tokens (JWTs) and CSRF tokens.
# Generate one with: `openssl rand -base64 48`
AUTH_SECRET=change-me-to-a-long-random-string

# --- Database -----------------------------------------------------------
# Path to the SQLite database file. Leave empty to use ./data/app.db
DATABASE_PATH=

# --- File storage -------------------------------------------------------
# Directory for uploaded media/documents. Leave empty to use ./uploads
UPLOAD_DIR=

# --- Demo admin (used by the seed script only) ---------------------------
ADMIN_NAME=Site Administrator
ADMIN_EMAIL=admin@maplebrook.edu
ADMIN_PASSWORD=ChangeMe123!

# --- Email (SMTP) — optional; when unset, outbound mail is written to /logs/mail
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Maplebrook Academy <no-reply@maplebrook.edu>"
